# Database and authentication
DATABASE_URL=
DATABASE_SSL=require
SESSION_SECRET=

# Backblaze B2 (S3-compatible API)
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
# Optional overrides; endpoint and public URL are derived from region/bucket by default.
B2_ENDPOINT=
B2_PUBLIC_URL=
B2_UPLOAD_PREFIX=cms
B2_REPORT_UPLOAD_PREFIX=reports
B2_TOPUP_UPLOAD_PREFIX=topup-proofs

# Writer application documents must use a private bucket.
B2_PRIVATE_BUCKET=
B2_PRIVATE_UPLOAD_PREFIX=writer-applications
# Optional dedicated credentials. Recommended when the CMS key is restricted
# to the public image bucket. Region falls back to B2_REGION when omitted.
B2_PRIVATE_REGION=
B2_PRIVATE_KEY_ID=
B2_PRIVATE_APP_KEY=
# Uses the existing B2_BUCKET when private storage is omitted. Documents are
# encrypted before upload regardless of bucket visibility.
B2_WRITER_UPLOAD_PREFIX=writer-applications-encrypted
# Generate with: openssl rand -base64 32
WRITER_APPLICATION_ENCRYPTION_KEY=

# Creator media is encrypted with the key above before being stored in the
# existing bucket. Public URLs expose ciphertext only; Web/Backoffice stream
# decrypted bytes through authenticated/authorized endpoints.
B2_CREATOR_STAGING_PREFIX=creator-content-encrypted

# Secret used by POST /api/cron/creator-payouts on the 25th of each month.
CRON_SECRET=
