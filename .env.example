# Database and authentication
DATABASE_URL=
DATABASE_SSL=require
SESSION_SECRET=
# Host port used by docker-compose PostgreSQL; change it if 5432 is occupied.
READLEAD_POSTGRES_PORT=5432

# Firebase Admin SDK for verifying member Google and Facebook sign-in tokens.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep this quoted when using \n escapes in a dotenv file.
FIREBASE_PRIVATE_KEY=

# Backblaze B2 (S3-compatible API)
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
# Optional overrides; endpoint and public URL are derived from region/bucket by default.
B2_ENDPOINT=
B2_PUBLIC_URL=
B2_UPLOAD_PREFIX=cms
B2_REPORT_UPLOAD_PREFIX=reports
B2_TOPUP_UPLOAD_PREFIX=topup-proofs

# Writer application documents must use a private bucket.
B2_PRIVATE_BUCKET=
B2_PRIVATE_UPLOAD_PREFIX=writer-applications
# Optional dedicated credentials. Recommended when the CMS key is restricted
# to the public image bucket. Region falls back to B2_REGION when omitted.
B2_PRIVATE_REGION=
B2_PRIVATE_KEY_ID=
B2_PRIVATE_APP_KEY=
# Uses the existing B2_BUCKET when private storage is omitted. Documents are
# encrypted before upload regardless of bucket visibility.
B2_WRITER_UPLOAD_PREFIX=writer-applications-encrypted
# Generate with: openssl rand -base64 32
WRITER_APPLICATION_ENCRYPTION_KEY=

# Creator media is encrypted with the key above before being stored in the
# existing bucket. Public URLs expose ciphertext only; Web/Backoffice stream
# decrypted bytes through authenticated/authorized endpoints.
B2_CREATOR_STAGING_PREFIX=creator-content-encrypted

# Secret used by POST /api/cron/creator-payouts on the 25th of each month.
CRON_SECRET=

# Public URL of the readlead-web app. Used as the return_uri Omise redirects
# the member back to after an off-site step (3DS challenge, TrueMoney app
# switch). Required for any gateway channel whose flow isn't a plain QR code.
WEB_APP_URL=http://localhost:3000

# Omise payment gateway (server-side charge creation).
# Use skey_test_... in development, skey_live_... in production.
OMISE_SECRET_KEY=
# Apple Pay merchant validation. Apple requires the merchant's own server to
# exchange the browser's validationURL for a merchant session using the Apple
# Merchant Identity Certificate — Omise does not do this on our behalf. Get
# the merchant ID and certificate from the Omise dashboard's tokenization
# certificates section after emailing support@omise.co to enable Apple Pay.
# Keep the PEM values quoted with \n escapes, like FIREBASE_PRIVATE_KEY.
APPLE_PAY_MERCHANT_ID=
APPLE_PAY_MERCHANT_CERT=
APPLE_PAY_MERCHANT_KEY=
# Shown on the Apple Pay sheet; defaults to "ReadLead" when unset.
APPLE_PAY_DISPLAY_NAME=

# Optional: base64 webhook signing secret from Omise dashboard > Webhooks
# Settings. When unset, POST /api/webhooks/omise still works safely — it
# re-fetches the charge from Omise's API by id rather than trusting the
# webhook body, so signature verification is defense-in-depth, not required.
OMISE_WEBHOOK_SECRET=
