// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  inactive
  banned
}

enum UserType {
  user
  creator
  admin
}

enum ContentStatus {
  pending
  approved
  rejected
}

enum ReportStatus {
  open
  in_progress
  resolved
}

enum ReportType {
  inappropriate_content
  spam
  copyright
  harassment
  other
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

enum AdType {
  banner
  interstitial
  in_content
}

// ─── User domain ─────────────────────────────────────────────────────────────

model User {
  id       String     @id @default(cuid())
  name     String
  email    String     @unique
  joinedAt DateTime   @default(now())
  status   UserStatus @default(active)
  userType UserType   @default(user)

  creatorProfile CreatorProfile?
  adminProfile   AdminProfile?
  punishments    PunishmentRecord[]
  reports        Report[]
  expAccount     ExpAccount?
  expEntries     ExpLedger[]
  ticketEntries  TicketLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreatorProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  works     Int     @default(0)
  followers Int     @default(0)
  revenue   Decimal @default(0) @db.Decimal(12, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  role         String
  lastLogin    DateTime?
  adminCode    String?   @unique
  passwordHash String    @default("")
  permissions  String[]  @default([])
  isOwner      Boolean   @default(false)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  AdminSession[]
  auditLogs AuditLog[]
}

model AdminSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  adminId   String
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model AuditLog {
  id        String        @id @default(cuid())
  adminId   String?
  admin     AdminProfile? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime      @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Content {
  id          String        @id @default(cuid())
  title       String
  author      String
  category    String
  status      ContentStatus @default(pending)
  chapters    Int           @default(0)
  submittedAt DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Reports ─────────────────────────────────────────────────────────────────

model Report {
  id         String       @id @default(cuid())
  senderId   String?
  sender     User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String
  subject    String
  type       ReportType
  date       DateTime     @default(now())
  status     ReportStatus @default(open)
  message    String       @db.Text

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  ReportMessage[]
}

model ReportMessage {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  senderType String
  senderName String
  message    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([reportId, createdAt])
}

// ─── Punishment ──────────────────────────────────────────────────────────────

model PunishmentLevel {
  id        String @id @default(cuid())
  level     Int    @unique
  name      String
  threshold Int
  duration  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PunishmentRecord {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelName String
  date      DateTime  @default(now())
  note      String?
  status    String    @default("active")
  expiresAt DateTime?

  createdAt DateTime @default(now())
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model MonthlyIncome {
  id           String   @id @default(cuid())
  month        String
  income       Decimal  @db.Decimal(12, 2)
  transactions Int
  creators     Int
  recordedAt   DateTime @default(now())
}

model WithdrawalRequest {
  id           String           @id @default(cuid())
  creator      String
  bank         String
  bankAccount  String
  amount       Decimal          @db.Decimal(12, 2)
  requestedAt  DateTime         @default(now())
  status       WithdrawalStatus @default(pending)
  slipUrl      String?
  reviewerName String?
  reviewedAt   DateTime?

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  history   WithdrawalHistory[]
}

model WithdrawalHistory {
  id           String            @id @default(cuid())
  withdrawalId String
  withdrawal   WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  status       WithdrawalStatus
  note         String?
  createdAt    DateTime          @default(now())

  @@index([withdrawalId, createdAt])
}

// ─── CMS / moderation ───

model CmsPage {
  id           String       @id @default(cuid())
  slug         String       @unique
  label        String
  slideSeconds Int          @default(5)
  sections     CmsSection[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model CmsSection {
  id        String    @id @default(cuid())
  pageId    String
  page      CmsPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  title     String
  enabled   Boolean   @default(true)
  sortOrder Int       @default(0)
  config    Json?
  items     CmsItem[]

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
}

model CmsItem {
  id        String     @id @default(cuid())
  sectionId String
  section   CmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  enabled   Boolean    @default(true)
  sortOrder Int        @default(0)
  config    Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sectionId, sortOrder])
}

model ModerationQueue {
  id          String   @id @default(cuid())
  title       String
  creatorName String
  reason      String
  chapter     String?
  status      String   @default("pending")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IpBlacklist {
  id        String   @id @default(cuid())
  term      String   @unique
  createdAt DateTime @default(now())
}

// ─── EXP and ticket ledgers ───

model ExpAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ExpLedger {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  action       String
  source       String
  status       String    @default("granted")
  reason       String?
  referenceId  String?
  reviewedAt   DateTime?
  reviewerName String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TicketLedger {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        String
  reason      String
  referenceId String?
  status      String   @default("completed")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Monetization ────────────────────────────────────────────────────────────

model Promotion {
  id        String   @id @default(cuid())
  name      String
  discount  Int
  validFrom DateTime
  validTo   DateTime
  active    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pricing {
  id              String @id @default(cuid())
  category        String @unique
  pricePerEpisode Int
  currency        String @default("เหรียญ")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VipLevel {
  id       String @id @default(cuid())
  level    Int    @unique
  name     String
  minSpend Int
  badge    String
  color    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpTitle {
  id     String @id @default(cuid())
  minExp Int    @unique
  title  String
  badge  String
  color  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Ads ─────────────────────────────────────────────────────────────────────

model AdPlacement {
  id       String  @id @default(cuid())
  name     String
  location String
  type     AdType
  active   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ad {
  id         String   @id @default(cuid())
  name       String
  advertiser String
  type       AdType
  validFrom  DateTime
  validTo    DateTime
  active     Boolean  @default(false)
  imageUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
