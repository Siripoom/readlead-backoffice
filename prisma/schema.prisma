// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  inactive
  banned
}

enum UserType {
  user
  creator
  admin
}

enum ContentStatus {
  pending
  approved
  rejected
}

enum ReportStatus {
  open
  in_progress
  resolved
}

enum ReportType {
  inappropriate_content
  spam
  copyright
  harassment
  other
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

enum AdType {
  banner
  interstitial
  in_content
}

enum WriterApplicantType {
  person
  company
}

enum WriterApplicationStatus {
  pending
  approved
  rejected
}

enum CreatorWorkType {
  novel
  manga
  audiobook
}

enum CreatorWorkOrigin {
  original
  translated
}

enum CreatorWorkStatus {
  draft
  pending_review
  approved
  published
  rejected
  deletion_pending
  archived
}

enum CreatorEpisodeType {
  text
  image
  audio
}

enum CreatorEpisodeStatus {
  draft
  scheduled
  published
  hidden
}

enum CreatorModerationType {
  publication
  translation
  deletion
}

enum CreatorModerationStatus {
  pending
  approved
  rejected
}

enum CoinLedgerKind {
  topup
  purchase
  refund
  adjustment
}

enum CreatorRevenueKind {
  earning
  withdrawal_reserve
  withdrawal_release
  withdrawal_paid
  adjustment
}

// ─── User domain ─────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  joinedAt     DateTime   @default(now())
  status       UserStatus @default(active)
  userType     UserType   @default(user)

  creatorProfile    CreatorProfile?
  adminProfile      AdminProfile?
  punishments       PunishmentRecord[]
  reports           Report[]
  expAccount        ExpAccount?
  expEntries        ExpLedger[]
  ticketEntries     TicketLedger[]
  memberSessions    MemberSession[]
  writerApplication WriterApplication?
  creatorWorks      CreatorWork[]             @relation("CreatorWorks")
  followedCreators  CreatorFollow[]           @relation("CreatorFollowers")
  followers         CreatorFollow[]           @relation("FollowedCreator")
  workShelves       WorkShelf[]
  workViews         WorkView[]
  workReviews       WorkReview[]
  workComments      WorkComment[]
  episodePurchases  EpisodePurchase[]
  coinAccount       CoinAccount?
  coinEntries       CoinLedger[]
  revenueEntries    CreatorRevenueLedger[]
  withdrawalRequests WithdrawalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model WriterApplication {
  id                  String                  @id @default(cuid())
  userId              String                  @unique
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantType       WriterApplicantType
  penName             String
  status              WriterApplicationStatus @default(pending)
  encryptedPayload    String                  @db.Text
  identityObjectKey   String
  identityContentType String
  bankObjectKey       String
  bankContentType     String
  termsVersion        String
  termsAcceptedAt     DateTime
  submittedAt         DateTime                @default(now())
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([status, submittedAt])
}

model CreatorProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  works     Int     @default(0)
  followers Int     @default(0)
  revenue   Decimal @default(0) @db.Decimal(12, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  role         String
  lastLogin    DateTime?
  adminCode    String?   @unique
  passwordHash String    @default("")
  permissions  String[]  @default([])
  isOwner      Boolean   @default(false)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  AdminSession[]
  auditLogs AuditLog[]
}

model AdminSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  adminId   String
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model AuditLog {
  id        String        @id @default(cuid())
  adminId   String?
  admin     AdminProfile? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime      @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Content {
  id          String        @id @default(cuid())
  title       String
  author      String
  category    String
  status      ContentStatus @default(pending)
  chapters    Int           @default(0)
  submittedAt DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreatorWork {
  id                 String            @id @default(cuid())
  creatorId          String
  creator            User              @relation("CreatorWorks", fields: [creatorId], references: [id], onDelete: Cascade)
  type               CreatorWorkType
  origin             CreatorWorkOrigin @default(original)
  status             CreatorWorkStatus @default(draft)
  title              String
  category           String
  rating             String            @default("general")
  creationMethod     String            @default("self_written")
  tagline            String            @default("") @db.Text
  synopsis           String            @default("") @db.Text
  tags               String[]          @default([])
  originalAuthor     String?
  translatorName     String?
  originalLanguage   String?
  originalTitle      String?
  coverObjectKey     String?
  coverContentType   String?
  coverIsPublic      Boolean           @default(false)
  seriesStatus       String            @default("ongoing")
  rejectionReason    String?
  approvedAt         DateTime?
  publishedAt        DateTime?
  views              Int               @default(0)
  coins              Int               @default(0)
  shelfCount         Int               @default(0)
  dailyVotes         Int               @default(0)
  monthlyVotes       Int               @default(0)
  reviewCount        Int               @default(0)
  commentCount       Int               @default(0)
  episodes           CreatorEpisode[]
  assets             WorkAsset[]
  moderationRequests CreatorModerationRequest[]
  dailyMetrics       WorkMetricDaily[]
  shelves            WorkShelf[]
  viewEvents         WorkView[]
  reviews            WorkReview[]
  comments           WorkComment[]
  purchases          EpisodePurchase[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([creatorId, status, updatedAt])
  @@index([status, publishedAt])
  @@index([type, status])
}

model CreatorEpisode {
  id              String               @id @default(cuid())
  workId          String
  work            CreatorWork          @relation(fields: [workId], references: [id], onDelete: Cascade)
  episodeNumber   Int
  title           String
  type            CreatorEpisodeType
  status          CreatorEpisodeStatus @default(draft)
  priceCoins      Int                  @default(0)
  content         String?              @db.Text
  scheduledAt     DateTime?
  publishedAt     DateTime?
  durationSeconds Int?
  assets          WorkAsset[]
  purchases       EpisodePurchase[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([workId, episodeNumber])
  @@index([workId, status, episodeNumber])
}

model WorkAsset {
  id              String          @id @default(cuid())
  workId          String
  work            CreatorWork     @relation(fields: [workId], references: [id], onDelete: Cascade)
  episodeId       String?
  episode         CreatorEpisode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  kind            String
  objectKey       String
  contentType     String
  sizeBytes       Int
  sortOrder       Int             @default(0)
  durationSeconds Int?
  isPublic        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@index([workId, episodeId, sortOrder])
}

model CreatorModerationRequest {
  id              String                    @id @default(cuid())
  workId          String
  work            CreatorWork               @relation(fields: [workId], references: [id], onDelete: Cascade)
  type            CreatorModerationType
  status          CreatorModerationStatus   @default(pending)
  reason          String?
  reviewerId      String?
  reviewedAt      DateTime?
  submittedAt     DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([status, submittedAt])
  @@index([workId, type, status])
}

model WorkMetricDaily {
  id           String      @id @default(cuid())
  workId       String
  work         CreatorWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  date         DateTime    @db.Date
  views        Int         @default(0)
  coins        Int         @default(0)
  revenueSatang Int        @default(0)
  shelfAdds    Int         @default(0)
  dailyVotes   Int         @default(0)
  monthlyVotes Int         @default(0)
  reviews      Int         @default(0)
  comments     Int         @default(0)

  @@unique([workId, date])
  @@index([date])
}

model CreatorFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("CreatorFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User     @relation("FollowedCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, creatorId])
  @@index([creatorId])
}

model WorkShelf {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      CreatorWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, workId])
  @@index([workId])
}

model WorkView {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  workId    String
  work      CreatorWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  viewerKey String
  viewedOn  DateTime    @db.Date
  createdAt DateTime    @default(now())

  @@unique([workId, viewerKey, viewedOn])
  @@index([workId, viewedOn])
}

model WorkReview {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      CreatorWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  rating    Int
  body      String      @db.Text
  status    String      @default("pending")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, workId])
  @@index([workId, status, createdAt])
}

model WorkComment {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      CreatorWork   @relation(fields: [workId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    WorkComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   WorkComment[] @relation("CommentReplies")
  body      String        @db.Text
  status    String        @default("published")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([workId, status, createdAt])
  @@index([parentId])
}

model EpisodePurchase {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId       String
  work         CreatorWork    @relation(fields: [workId], references: [id], onDelete: Cascade)
  episodeId    String
  episode      CreatorEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  coinsSpent   Int
  revenueSatang Int
  purchasedAt  DateTime       @default(now())

  @@unique([userId, episodeId])
  @@index([workId, purchasedAt])
}

model CoinAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CoinLedger {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           CoinLedgerKind
  amount         Int
  balanceAfter   Int
  referenceId    String?
  idempotencyKey String?        @unique
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([referenceId])
}

model CreatorRevenueLedger {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           CreatorRevenueKind
  amountSatang   Int
  referenceId    String?
  idempotencyKey String?            @unique
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([referenceId])
}

// ─── Reports ─────────────────────────────────────────────────────────────────

model Report {
  id         String       @id @default(cuid())
  senderId   String?
  sender     User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String
  subject    String
  type       ReportType
  date       DateTime     @default(now())
  status     ReportStatus @default(open)
  message    String       @db.Text

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  ReportMessage[]
}

model ReportMessage {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  senderType String
  senderName String
  message    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([reportId, createdAt])
}

// ─── Punishment ──────────────────────────────────────────────────────────────

model PunishmentLevel {
  id        String @id @default(cuid())
  level     Int    @unique
  name      String
  threshold Int
  duration  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PunishmentRecord {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelName String
  date      DateTime  @default(now())
  note      String?
  status    String    @default("active")
  expiresAt DateTime?

  createdAt DateTime @default(now())
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model MonthlyIncome {
  id           String   @id @default(cuid())
  month        String
  income       Decimal  @db.Decimal(12, 2)
  transactions Int
  creators     Int
  recordedAt   DateTime @default(now())
}

model WithdrawalRequest {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  creator      String
  bank         String
  bankAccount  String
  amount       Decimal          @db.Decimal(12, 2)
  amountSatang Int?
  taxSatang    Int?
  feeSatang    Int?             @default(0)
  netSatang    Int?
  encryptedDestination String?  @db.Text
  payoutMode   String           @default("advance")
  payoutPeriod String?
  requestedAt  DateTime         @default(now())
  status       WithdrawalStatus @default(pending)
  slipUrl      String?
  reviewerName String?
  reviewedAt   DateTime?

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  history   WithdrawalHistory[]

  @@index([userId, status, requestedAt])
  @@unique([userId, payoutPeriod])
}

model WithdrawalHistory {
  id           String            @id @default(cuid())
  withdrawalId String
  withdrawal   WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  status       WithdrawalStatus
  note         String?
  createdAt    DateTime          @default(now())

  @@index([withdrawalId, createdAt])
}

// ─── CMS / moderation ───

model CmsPage {
  id           String       @id @default(cuid())
  slug         String       @unique
  label        String
  slideSeconds Int          @default(5)
  sections     CmsSection[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model CmsSection {
  id        String    @id @default(cuid())
  pageId    String
  page      CmsPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  title     String
  enabled   Boolean   @default(true)
  sortOrder Int       @default(0)
  config    Json?
  items     CmsItem[]

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
}

model CmsItem {
  id        String     @id @default(cuid())
  sectionId String
  section   CmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  enabled   Boolean    @default(true)
  sortOrder Int        @default(0)
  config    Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sectionId, sortOrder])
}

model ModerationQueue {
  id          String   @id @default(cuid())
  title       String
  creatorName String
  reason      String
  chapter     String?
  status      String   @default("pending")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IpBlacklist {
  id        String   @id @default(cuid())
  term      String   @unique
  createdAt DateTime @default(now())
}

// ─── EXP and ticket ledgers ───

model ExpAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt
}

model ExpLedger {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  action       String
  source       String
  status       String    @default("granted")
  reason       String?
  referenceId  String?
  reviewedAt   DateTime?
  reviewerName String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TicketLedger {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        String
  reason      String
  referenceId String?
  idempotencyKey String? @unique
  status      String   @default("completed")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Monetization ────────────────────────────────────────────────────────────

model Promotion {
  id        String   @id @default(cuid())
  name      String
  discount  Int
  validFrom DateTime
  validTo   DateTime
  active    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pricing {
  id              String @id @default(cuid())
  category        String @unique
  pricePerEpisode Int
  currency        String @default("เหรียญ")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VipLevel {
  id       String @id @default(cuid())
  level    Int    @unique
  name     String
  minSpend Int
  badge    String
  color    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpTitle {
  id     String @id @default(cuid())
  minExp Int    @unique
  title  String
  badge  String
  color  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Ads ─────────────────────────────────────────────────────────────────────

model AdPlacement {
  id       String  @id @default(cuid())
  name     String
  location String
  type     AdType
  active   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ad {
  id         String   @id @default(cuid())
  name       String
  advertiser String
  type       AdType
  validFrom  DateTime
  validTo    DateTime
  active     Boolean  @default(false)
  imageUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
