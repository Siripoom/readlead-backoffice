    "start": "next start",
    "lint": "eslint",
    "test:cms": "tsx --test tests/cms-config.test.ts",
    "test:exp": "tsx --test tests/exp-rules.test.ts",
    "test:member-auth": "tsx --test tests/social-member-auth.test.ts",
    "test:media": "node --experimental-test-module-mocks --import tsx --test tests/creator-media-range.test.mts",
    "test:payment-channels": "node --experimental-test-module-mocks --import tsx --test tests/payment-channel-settings.test.mts",
    "test:payouts": "node --experimental-test-module-mocks --import tsx --test tests/creator-payouts.test.mts",
